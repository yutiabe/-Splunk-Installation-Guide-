$TTL 1D
@       IN SOA  dns.tilda.net.   root.tilda.net. (
                                        0       ; serial
                                        1D      ; refresh
                                        1H      ; retry
                                        1W      ; expire
                                        3H )    ; minimum
; DNS server information here
@   IN  NS dns.tilda.net.
@   IN  A  10.0.0.10



10      IN    PTR     dns.tilda.net.  
11      IN    PTR     ansible.tilda.net.  
12      IN    PTR     nfs.tilda.net.  
13      IN    PTR     workstation.tilda.net.  
14      IN    PTR     www.tilda.net.  







